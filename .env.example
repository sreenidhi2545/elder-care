# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string for the eldercare database.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/eldercare

# Secret used to sign access tokens. Use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me

# Port the backend listens on.
PORT=5000

# Optional token lifetimes. Defaults shown.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# Country assumed when someone types a phone number with no country code.
# Numbers already written in international form (+... or 00...) are accepted
# for any country whatever these say. Defaults shown: India.
# DEFAULT_CALLING_CODE=91
# DEFAULT_NATIONAL_DIGITS=10
